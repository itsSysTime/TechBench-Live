name: Append new options to tb.html

on:
  workflow_run:
    workflows: ["Generate option-values.json"]
    types:
      - completed
  workflow_dispatch:

jobs:
  update-html:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true
          clean: false

      - name: Ensure local main is up-to-date
        run: |
          # Find the branch name (fallback to 'main' if not found)
          BRANCH=${GITHUB_REF#refs/heads/}
          if [ -z "$BRANCH" ] || [ "$BRANCH" = "refs/heads/" ]; then
            BRANCH=main
          fi
      
          git fetch --no-tags --prune origin +refs/heads/*:refs/remotes/origin/*
          # If the local branch exists, check it out; otherwise create it from origin
          if git rev-parse --verify "$BRANCH" >/dev/null 2>&1; then
            git checkout "$BRANCH"
          else
            git checkout -b "$BRANCH" "origin/$BRANCH"
          fi
          git pull --rebase origin "$BRANCH" || true


      - name: Extract existing IDs from tb.html
        run: |
          # Extract option block and existing IDs in their current display order
          sed -n '/<!-- OPT-START -->/,/<!-- OPT-END -->/p' tb.html > options_block.tmp
          grep -oP '<option\s+value="\K[0-9]+' options_block.tmp > existing_ids.tmp

      - name: Extract new IDs from option-values.json
        run: |
          jq -r '.products | keys[]' option-values.json | sort -n > new_ids.tmp

      - name: Compute missing IDs
        run: |
          # IDs present in JSON but not currently in tb.html (preserve one per line)
          grep -vxFf existing_ids.tmp new_ids.tmp > missing_ids.tmp || true

      - name: Generate missing <option> tags (for reference)
        run: |
          # Create/empty append_options.tmp
          : > append_options.tmp
          # For each missing id, read the label from option-values.json and append an <option> line
          while IFS= read -r id; do
            label=$(jq -r --arg id "$id" '.products[$id] // "Unknown"' option-values.json)
            printf '<option value="%s">%s</option>\n' "$id" "$label" >> append_options.tmp
          done < missing_ids.tmp

      - name: Insert missing IDs at numeric positions and build index
        run: |
          set -euo pipefail

          # Normalize and unique-sort missing IDs numerically
          sort -n missing_ids.tmp | uniq > unique_missing_ids.tmp || true

          # Load missing IDs into array (processing order: ascending)
          mapfile -t missing < unique_missing_ids.tmp || true

          # Load existing IDs in their current display order into array
          mapfile -t existing < existing_ids.tmp || true

          # Work on a copy of the html
          cp tb.html tb.new.html

          # Prepare JSON index for missing items
          echo "[" > missing_index.json
          first=true

          # Helper function to insert option after a matching option value
          insert_after_prev() {
            prev_val="$1"
            opt_line="$2"
          
            if [ -z "$prev_val" ]; then
              awk -v opt="$opt_line" '/<!-- OPT-START -->/ { print; print opt; next } { print }' tb.new.html > tb.tmp && mv tb.tmp tb.new.html
            else
              awk -v prev="$prev_val" -v opt="$opt_line" '{ if (index($0, "value=\\\"" prev "\\\"")) { print; print opt; next } print }' tb.new.html > tb.tmp && mv tb.tmp tb.new.html
            fi
          }

          # Iterate missing IDs in ascending order so earlier small IDs are placed first
          for id in "${missing[@]:-}"; do
            # Build label and option line
            label=$(jq -r --arg id "$id" '.products[$id] // "Unknown"' option-values.json)
            # Escape backslashes and double quotes for safe insertion into awk variable
            esc_label=$(printf '%s' "$label" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
            option_line="<option value=\"$id\">$esc_label</option>"

            # Append to missing_index.json
            if [ "$first" = true ]; then
              first=false
            else
              echo "," >> missing_index.json
            fi
            # Escape quotes in label for JSON
            json_label=$(printf '%s' "$label" | sed 's/"/\\"/g')
            printf '  {"id":"%s","label":"%s"}' "$id" "$json_label" >> missing_index.json

            # Determine the preferred previous ID: check id-1 first
            prev_candidate=$((id - 1))
            placed=false

            if [ "$prev_candidate" -ge 0 ]; then
              # Check if prev_candidate exists in current existing array
              for i in "${!existing[@]}"; do
                if [ "${existing[$i]}" = "$prev_candidate" ]; then
                  insert_after_prev "$prev_candidate" "$option_line"

                  # Insert id into existing array after index i
                  idx=$((i + 1))
                  existing=("${existing[@]:0:$idx}" "$id" "${existing[@]:$idx}")
                  printf "%s\n" "${existing[@]}" > existing_ids.tmp
                  placed=true
                  break
                fi
              done
            fi

            if [ "$placed" = false ]; then
              # If direct prev not found, find the greatest existing ID less than current id
              candidate_index=-1
              for i in "${!existing[@]}"; do
                if [ "${existing[$i]}" -lt "$id" ]; then
                  candidate_index=$i
                fi
              done

              if [ "$candidate_index" -ge 0 ]; then
                candidate_id=${existing[$candidate_index]}
                insert_after_prev "$candidate_id" "$option_line"
                idx=$((candidate_index + 1))
                existing=("${existing[@]:0:$idx}" "$id" "${existing[@]:$idx}")
                placed=true
              else
                # No previous existing ID less than id → insert after OPT-START (beginning)
                insert_after_prev "" "$option_line"
                # Prepend to existing array
                existing=("$id" "${existing[@]}")
                placed=true
              fi
            fi

            # Remove this id from missing_ids.tmp so it's updated after each detection
            if [ -f missing_ids.tmp ]; then
              grep -vxF "$id" missing_ids.tmp > missing_ids.tmp.tmp || true
              mv missing_ids.tmp.tmp missing_ids.tmp || true
            fi

          done

          # Close JSON array
          echo "" >> missing_index.json
          echo "]" >> missing_index.json

          # Replace final file
          mv tb.new.html tb.html

          # Update a helper file with updated existing IDs order (for debugging/verification)
          printf "%s\n" "${existing[@]}" > sorted_existing_ids_after_insert.tmp || true

          # If there are still ids left in missing_ids.tmp (unplaceable), keep them; otherwise remove file
          if [ ! -s missing_ids.tmp ]; then
            rm -f missing_ids.tmp || true
          fi

      - name: Commit updated tb.html and index
        run: |
          git config user.name "GitHub Actions"
          git config user.email "actions@github.com"
          git add tb.html missing_index.json || true
          git commit -m "Append new options to tb.html and add missing_index.json" || echo "No changes"
          git push || true

      - name: Upload artifact for GitHub Pages
        uses: actions/upload-pages-artifact@v3
        with:
          path: .

  deploy:
    needs: update-html
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    steps:
      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v4
